from pathlib import Path
from PIL import Image

src = Path('/home/emanuele/.codex/generated_images/01a12eb4-bad8-7c82-976f-259906419a0f/exec-a44b63d3-8ab8-46a2-acad-be58abb1c0cf.png')
dst = Path('/home/emanuele/Documenti/goblin/assets/_codex/nix_hills_02.png')
dst.parent.mkdir(parents=True, exist_ok=True)

with Image.open(src) as source:
    image = source.convert('RGBA')
    alpha = image.getchannel('A')
    clean_alpha = alpha.point(lambda value: 0 if value < 240 else value)
    cleared = clean_alpha.point(lambda value: 255 if value == 0 else 0)
    image.paste((0, 0, 0, 0), mask=cleared)
    image.putalpha(clean_alpha)
    image.save(dst, format='PNG')

with Image.open(dst) as checked:
    top_alpha = list(checked.getchannel('A').crop((0, 0, checked.width, 1)).getdata())
    assert checked.size == (1536, 1024), checked.size
    assert checked.mode == 'RGBA', checked.mode
    assert all(value == 0 for value in top_alpha), (min(top_alpha), max(top_alpha))
    print(f'percorso: {dst}')
    print(f'dimensioni: {checked.width}x{checked.height}')
    print(f'modalità: {checked.mode}')
    print(f'alpha riga superiore: min={min(top_alpha)}, max={max(top_alpha)}')
